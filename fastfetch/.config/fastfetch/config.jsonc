{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/arch-logo.txt",
        "type": "auto",
        "color": {
            "6": "blue" 
        },
        "padding": {
            "top": 1,
            "left": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " 󰁔 ", 
        "color": {
            "keys": "blue",
            "title": "blue"
        },
        "key": {
            "width": 15 
        }
    },
    "modules": [
        "title",
        {
            "type": "separator",
            "string": "━"     // Heavy, solid tech bar under the title block
        },
        // Group 1: System Core
        {
            "type": "os",
            "key": "󰣇 OS"
        },
        {
            "type": "kernel",
            "key": " Kernel",
            "format": "{2}"
        },
        {
            "type": "uptime",
            "key": "󱎫 Uptime"
        },
        {
            "type": "packages",
            "key": "󰏖 Packages"
        },
        {
            "type": "separator",
            "string": "·"     // Repeats as a clean, fine dot-matrix divider line
        },
        // Group 2: Environment
        {
            "type": "wm",
            "key": " WM"
        },
        {
            "type": "shell",
            "key": "󱆃 Shell"
        },
        {
            "type": "terminal",
            "key": " Terminal"
        },
        {
            "type": "separator",
            "string": "·"     // Matching dot-matrix divider line
        },
        // Group 3: Hardware Specs
        {
            "type": "cpu",
            "key": " CPU",
            "format": "{1}"
        },
        {
            "type": "gpu",
            "key": "󰢮 GPU",
            "format": "{2}"
        },
        {
            "type": "memory",
            "key": " Memory"
        },
        {
            "type": "disk",
            "key": "󰋊 Disk",
            "format": "{1} / {2} ({6})"
        },
        {
            "type": "board",
            "key": "󰘚 Board"
        },
        "break", 
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}
