{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/logo.txt",
        "type": "auto",
        "color": {
            "6": "blue"
        },
        "padding": {
            "top": 2,
            "left": 1,
            "right": 2
        }
    },
    "display": {
        "separator": " ➜  ",
        "color": {
            "separator": "white"
        }
    },
    "modules": [
        "break",
        // DISTRO GROUP
        {
            "type": "os",
            "key": "󰣇 DISTRO",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": " ├─  ",
            "keyColor": "34"
        },
        {
            "type": "packages",
            "key": " ├─ 󰏖 ",
            "keyColor": "34"
        },
        {
            "type": "uptime",
            "key": " ├─ 󰅐 ",
            "keyColor": "34"
        },
        {
            "type": "shell",
            "key": " └─  ",
            "keyColor": "34"
        },
        "break",
        // DE/WM GROUP
        {
            "type": "wm",
            "key": " DE/WM",
            "keyColor": "33"
        },
        {
            "type": "wmtheme",
            "key": " ├─ 󰉼 ",
            "keyColor": "33"
        },
        {
            "type": "icons",
            "key": " ├─ 󰀻 ",
            "keyColor": "33"
        },
        {
            "type": "font",
            "key": " ├─  ",
            "keyColor": "33"
        },
        {
            "type": "terminal",
            "key": " └─  ",
            "keyColor": "33"
        },
        "break",
        // SYSTEM GROUP
        {
            "type": "host",
            "key": "󰌢 SYSTEM",
            "keyColor": "36"
        },
        {
            "type": "cpu",
            "key": " ├─  ",
            "keyColor": "36"
        },
        {
            "type": "gpu",
            "key": " ├─ 󰢮 ",
            "keyColor": "36"
        },
        {
            "type": "display",
            "key": " ├─ 󰹑 ",
            "keyColor": "36"
        },
        {
            "type": "memory",
            "key": " ├─ 󰍛 ",
            "keyColor": "36"
        },
        {
            "type": "localip",
            "key": " ├─ 󰲛 ",
            "keyColor": "36"
        },
        {
            "type": "battery",
            "key": " └─  ",
            "keyColor": "36"
        },
        "break",
        // AUDIO GROUP
        {
            "type": "sound",
            "key": " AUDIO",
            "keyColor": "35"
        },
        "break",
        {
            "type": "colors",
            "symbol": "circle"
        }
    ]
}