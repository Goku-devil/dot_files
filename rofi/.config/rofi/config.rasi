/* --- Main Rofi Layout --- */
configuration {
    modi: "drun,run,window,emoji";
    show-icons: true;
    display-drun: "  Apps";
    display-run: "  Run";
    display-window: "  Window";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 12";
    emoji-format: "{emoji}";
    me-select-entry: "";
    me-accept-entry: "MousePrimary";
    hover-select: true;
}

/* Import dynamically linked colors */
@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @fg-base;
    margin: 0;
    padding: 0;
}

window {
    width: 450px;
    border: 2px solid;
    border-color: @accent-lavender;
    border-radius: 2px;          
    background-color: @bg-base;
    padding: 18px;
}

mainbox {
    spacing: 12px;
}

inputbar {
    spacing: 10px;
    padding: 12px;
    background-color: @bg-alt;
    border-radius: 6px;
    children: [ prompt, entry ];
}

prompt {
    text-color: @accent-lavender;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    placeholder: "Search...";
    placeholder-color: @fg-muted;
    text-color: @fg-base;
}

listview {
    spacing: 6px;
    scrollbar: false;
    border: 0px;
    fixed-height: false;    
    columns: 1;
    lines: 8;
}

element {
    padding: 12px 16px;
    border-radius: 6px;
    spacing: 12px;
    background-color: transparent;
    orientation: horizontal;
}

/* --- Fixed Element States --- */
element normal.normal {
    background-color: transparent;
    text-color: @fg-base;
}

element alternate.normal {
    background-color: transparent;
    text-color: @fg-base;
}

element selected.normal {
    background-color: @bg-surface;
    text-color: @accent-sapphire;
    border: 1px solid;
    border-color: @accent-lavender;
}

element-icon {
    size: 28px;
    background-color: transparent;
    text-color: inherit;
}

element-text {
    enabled: true;
    horizontal-align: 0.0;
    vertical-align: 0.5;
    background-color: transparent;
    text-color: inherit;    
}