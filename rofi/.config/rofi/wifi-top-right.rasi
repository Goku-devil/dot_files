@import "colors.rasi"

configuration {
    show-icons: false;
}

window {
    width: 400px;
    location: northeast;
    anchor: northeast;
    x-offset: 0px;
    y-offset: 0px;

    background-color: @bg-base;
    border: 2px;
    border-color: @accent-lavender;
    border-radius: 2px;
}

mainbox {
    background-color: transparent;
    spacing: 10px;
    padding: 20px;
}

/* --- Search Bar --- */
inputbar {
    background-color: @bg-alt; 
    text-color: @fg-base;
    border-radius: 8px;
    padding: 12px 15px;
    border: 1px;
    border-color: @bg-surface;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @accent-sapphire; 
    margin: 0px 12px 0px 0px;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    background-color: transparent;
    text-color: @fg-base;
    placeholder: "Search Networks...";
    placeholder-color: @fg-muted;
}

/* --- List Area --- */
listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    dynamic: true;
    scrollbar: false;
    spacing: 8px;
    cycle: true;
    
    /* Adds a subtle separator line below the search bar */
    border: 2px 0px 0px 0px;
    border-color: @bg-surface;
    padding: 15px 0px 0px 0px;
}

/* --- Base Element Settings --- */
element {
    background-color: transparent;
    border-radius: 8px;
    padding: 10px 15px;
    /* Hidden left border that acts as an accent edge */
    border: 0px 0px 0px 4px;
    border-color: transparent;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

/* --- State Colors --- */

/* Standard unselected items */
element normal.normal, element alternate.normal {
    text-color: @fg-base;
}

/* Currently connected network */
element normal.active, element alternate.active {
    text-color: @accent-lavender;
    border-color: @accent-lavender; /* Lights up the left edge */
}

/* Currently selected item via keyboard/mouse */
element selected.normal, element selected.active {
    background-color: @bg-surface;
    text-color: @accent-sapphire;
    border-color: @accent-sapphire; /* Lights up the left edge */
}