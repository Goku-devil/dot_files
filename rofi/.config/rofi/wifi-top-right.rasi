@import "colors.rasi"

configuration {
    show-icons: false;
}

window {
    width: 380px;
    
    /* Change these from northwest to northeast */
    location: northeast;
    anchor: northeast;
    
    /* Make x-offset negative to pull it away from the right edge */
    x-offset: 0px; 
    y-offset: 0px; 

    background-color: @bg-base;
    border: 2px;
    border-color: @accent-lavender;
    border-radius: 2px;
}

mainbox {
    background-color: transparent;
    spacing: 10px;
    padding: 15px;
}

/* --- Search Bar --- */
inputbar {
    background-color: @bg-surface;
    text-color: @fg-base;
    border-radius: 8px;
    padding: 10px;
    children: [ prompt, entry ];
}

prompt {
    background-color: transparent;
    text-color: @accent-lavender;
    margin: 0px 10px 0px 0px;
    font: "JetBrainsMono Nerd Font Bold 12";
}

entry {
    background-color: transparent;
    text-color: @fg-base;
    placeholder: "Search...";
    placeholder-color: @fg-muted;
}

/* --- List Area --- */
listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    fixed-height: true;
    dynamic: true; /* FIX: Shrinks the window if there are fewer than 8 networks */
    scrollbar: false;
    spacing: 6px;
    cycle: true;
}

/* --- Base Element Settings --- */
element {
    border-radius: 6px;
    padding: 8px 12px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    vertical-align: 0.5;
}

/* --- FIX: Override Rofi's specific default classes --- */

/* Standard unselected items */
element normal.normal, element alternate.normal {
    background-color: transparent;
    text-color: @fg-base;
}

/* Currently connected network (Fixes the cream box) */
element normal.active, element alternate.active {
    background-color: transparent;
    text-color: @accent-lavender;
}

/* Currently selected item via keyboard/mouse (Fixes the bright blue box) */
element selected.normal, element selected.active {
    background-color: @bg-surface;
    text-color: @accent-sapphire;
}