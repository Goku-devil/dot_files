#!/usr/bin/env bash

set -e

BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TARGET_DIR="$HOME"

# ====================
# Aesthetics & Colors
# ====================
CYAN='\033[38;2;0;255;255m'
MAGENTA='\033[38;2;255;0;255m'
LIME='\033[38;2;57;255;20m'
YELLOW='\033[38;2;255;255;0m'
RED='\033[38;2;255;100;100m'
BLUE='\033[38;2;100;149;237m'
GREEN='\033[0;32m'

# Text formatting
DIM='\033[2m'
BOLD='\033[1m'
NC='\033[0m' # No Color

# Visual elements
CHECK='✓'
CROSS='✗'
ARROW='→'
PIPE='│'
STEP='●'

# Tracking statistics
INSTALLED_COUNT=0
SKIPPED_COUNT=0
FAILED_COUNT=0

# ==========================================
# UI Functions
# ==========================================
print_header() {
    clear
    echo -e "${CYAN}${BOLD}"
    cat << "EOF"
 ╭────────────────────────────────────────────────────────────────────────╮
 │                                                                        │
 │        ______       __            '       _____      __                │
 │       / ____/____  / /__ __  __          / ___/___  / /_ __  __ ____   │
 │      / / __ / __ \/ //_// / / /  ____   \__ \/ _ \/ __// / / // __ \   │
 │     / /_/ // /_/ / ,<  / /_/ /  /___/  ___/ /  __/ /_ / /_/ // /_/ /   │
 │     \____/ \____/_/|_| \__,_/         /____/\___/\__/ \__,_// .___/    │
 │                                                             /_/        │
 │      ❯ ARCH LINUX  •  HYPRLAND  •  DOTFILES DEPLOYMENT                 │
 │                                                                        │
 ╰────────────────────────────────────────────────────────────────────────╯
EOF
    echo -e "${NC}\n"
}

print_section() {
    echo -e "\n${CYAN}${BOLD}${PIPE} $1${NC}"
    echo -e "${CYAN}${DIM}$(printf '━%.0s' {1..75})${NC}"
}

print_info() {
    echo -e "${MAGENTA}${STEP}${NC} ${BOLD}$1${NC}"
}

print_success() {
    echo -e "${LIME}${CHECK}${NC} $1"
}

print_error() {
    echo -e "${RED}${CROSS}${NC} ${BOLD}Error: $1${NC}"
}

print_skip() {
    echo -e "${DIM}${ARROW} $1${NC} ${YELLOW}[skipped]${NC}"
}

# ==========================================
# Script Execution
# ==========================================
print_header

# ------------------------------------------
# STEP 1: Core Dependencies & AUR Helper
# ------------------------------------------
print_section "STEP 1: Synchronizing Core Dependencies"

print_info "Installing git and base-devel..."
sudo pacman -S --needed --noconfirm git base-devel
INSTALLED_COUNT=$((INSTALLED_COUNT + 1))

if ! command -v yay &> /dev/null; then
    print_info "Bootstrapping yay (AUR Helper)..."
    git clone https://aur.archlinux.org/yay.git /tmp/yay
    cd /tmp/yay
    makepkg -si --noconfirm
    cd - > /dev/null
    rm -rf /tmp/yay
    print_success "yay installed successfully."
    INSTALLED_COUNT=$((INSTALLED_COUNT + 1))
else
    print_skip "yay"
    SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
fi

# ------------------------------------------
# STEP 2: Official Arch Packages
# ------------------------------------------
print_section "STEP 2: Evaluating Official Repository Packages"

OFFICIAL_PACKAGES=(
    rofi neovim swaync hyprshot hypridle hyprlock hyprsunset stow
    ttf-jetbrains-mono-nerd cliphist wl-clipboard wtype rofi-emoji
    noto-fonts-emoji xclip fastfetch dolphin tk nodejs npm ddcutil firefox 
    wf-recorder hyprland playerctl
)

print_info "Scanning ${#OFFICIAL_PACKAGES[@]} packages..."

MISSING_OFFICIAL=()
for pkg in "${OFFICIAL_PACKAGES[@]}"; do
    if pacman -Qq "$pkg" &> /dev/null; then
        print_skip "$pkg"
        SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    else
        MISSING_OFFICIAL+=("$pkg")
    fi
done

if [ ${#MISSING_OFFICIAL[@]} -gt 0 ]; then
    print_info "Installing ${#MISSING_OFFICIAL[@]} missing package(s)..."
    sudo pacman -S --noconfirm "${MISSING_OFFICIAL[@]}"
    print_success "Official packages synchronized. (${#MISSING_OFFICIAL[@]} installed)"
    INSTALLED_COUNT=$((INSTALLED_COUNT + ${#MISSING_OFFICIAL[@]}))
else
    print_success "All official packages up to date!"
fi

# ------------------------------------------
# STEP 3: AUR Packages
# ------------------------------------------
print_section "STEP 3: Evaluating AUR Packages"

AUR_PACKAGES=(
    visual-studio-code-bin
    waybar-git
    wl-clip-persist
    wlogout
    zscroll-git
)

print_info "Scanning ${#AUR_PACKAGES[@]} AUR packages..."

MISSING_AUR=()
for pkg in "${AUR_PACKAGES[@]}"; do
    if pacman -Qq "$pkg" &> /dev/null; then
        print_skip "$pkg"
        SKIPPED_COUNT=$((SKIPPED_COUNT + 1))
    else
        MISSING_AUR+=("$pkg")
    fi
done

if [ ${#MISSING_AUR[@]} -gt 0 ]; then
    print_info "Installing ${#MISSING_AUR[@]} missing AUR package(s)..."
    yay -S --noconfirm "${MISSING_AUR[@]}"
    print_success "AUR packages synchronized. (${#MISSING_AUR[@]} installed)"
    INSTALLED_COUNT=$((INSTALLED_COUNT + ${#MISSING_AUR[@]}))
else
    print_success "All AUR packages up to date!"
fi

# ------------------------------------------
# STEP 4: Dotfiles Deployment (GNU Stow)
# ------------------------------------------
print_section "STEP 4: Deploying Dotfiles Configuration"

cd "$BASE_DIR" || { print_error "Failed to enter $BASE_DIR"; exit 1; }

# Gather packages (folders that don't start with a dot)
PACKAGES=$(find . -maxdepth 1 -mindepth 1 -type d ! -name ".*" -exec basename {} \; | sort)

if [ -z "$PACKAGES" ]; then
    print_error "No stow packages found in $BASE_DIR"
    FAILED_COUNT=$((FAILED_COUNT + 1))
else
    # Automatically clear out default configs to prevent Stow conflicts
    print_info "Clearing default configurations..."
    
    CONFLICTING_TARGETS=(
        "$HOME/.bashrc"
        "$HOME/.config/fastfetch"
        "$HOME/.config/hypr"
        "$HOME/.config/kitty"
        "$HOME/.config/nvim"
        "$HOME/.config/rofi"
        "$HOME/.config/swaync"
        "$HOME/.config/waybar"
        "$HOME/.config/wlogout"
    )

    for target in "${CONFLICTING_TARGETS[@]}"; do
        if [ -e "$target" ] || [ -L "$target" ]; then
            rm -rf "$target"
            echo -e "  ${DIM}${ARROW} Removed existing ${target}${NC}"
        fi
    done

    echo ""
    print_info "Stowing configurations to $TARGET_DIR..."
    
    # Temporarily disable exit-on-error just in case an unexpected conflict occurs
    set +e 
    
    for package in $PACKAGES; do
        printf "  ${CYAN}%-32s${NC}" "Stowing $package..."
        
        # Run stow quietly, capturing both stdout and stderr
        ERROR_MSG=$(stow -R -t "$TARGET_DIR" "$package" 2>&1)
        STOW_STATUS=$?
        
        if [ $STOW_STATUS -eq 0 ]; then
            printf " ${GREEN}${BOLD}%s${NC}\n" "${CHECK} OK"
        else
            printf " ${RED}${BOLD}%s${NC}\n" "${CROSS} FAIL"
            echo -e "${DIM}${ERROR_MSG}${NC}" | sed 's/^/      /'
            FAILED_COUNT=$((FAILED_COUNT + 1))
        fi
    done
    
    # Re-enable exit-on-error
    set -e
fi
# ------------------------------------------
# Deployment Summary
# ------------------------------------------
print_section "📊 DEPLOYMENT SUMMARY"

echo -e "${BLUE}${BOLD}Installation Statistics:${NC}"
echo -e "  ${LIME}✓ Installed / Synced:${NC} $INSTALLED_COUNT"
echo -e "  ${YELLOW}→ Skipped (Already met):${NC} $SKIPPED_COUNT"
[ "$FAILED_COUNT" -gt 0 ] && echo -e "  ${RED}✗ Failed Tasks:${NC} $FAILED_COUNT"

echo ""
if [ "$FAILED_COUNT" -eq 0 ]; then
    echo -e "${CYAN}${BOLD}System architecture deployed successfully!${NC}"
    echo -e "${DIM}All components are ready for your Wayland workflow.${NC}"
else
    echo -e "${YELLOW}${BOLD}Deployment completed with some errors.${NC}"
    echo -e "${DIM}Please review the logs above for failed tasks.${NC}"
fi

echo ""
print_info "Bootstrapping default Nord theme..."
~/.config/hypr/scripts/apply_theme.sh nord

echo -e "${CYAN}Enjoy the Stay! 🚀${NC}\n"