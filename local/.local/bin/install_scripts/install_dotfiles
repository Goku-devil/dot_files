#!/bin/bash

# Define directories
DOTFILES_DIR="$HOME/.dotfiles"
TARGET_DIR="$HOME"

# Color definitions
BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[0;33m'
CYAN='\033[0;36m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

ICON_OK="✓"
ICON_FAIL="✖"
ICON_INFO="➜"

echo -e "${CYAN}${BOLD}┌─────────────────────────────────────────────────────┐${NC}"
echo -e "${CYAN}${BOLD}│  Initiating dotfiles deployment                     │${NC}"
echo -e "${CYAN}${BOLD}└─────────────────────────────────────────────────────┘${NC}\n"

# 1. Verify GNU Stow is installed
if ! command -v stow &> /dev/null; then
    echo -e "  ${RED}${BOLD}${ICON_FAIL}  stow not found${NC}"
    echo -e "    ${YELLOW}${ICON_INFO} Install it with your package manager (eg. apt, pacman, brew).${NC}"
    exit 1
fi

# 2. Check if the .dotfiles directory exists
if [ ! -d "$DOTFILES_DIR" ]; then
    echo -e "  ${RED}${BOLD}${ICON_FAIL}  Directory not found: ${NC}$DOTFILES_DIR"
    exit 1
fi

cd "$DOTFILES_DIR" || exit 1

# 3. Gather packages
PACKAGES=$(find . -maxdepth 1 -mindepth 1 -type d ! -name ".*" -exec basename {} \; | sort)

if [ -z "$PACKAGES" ]; then
    echo -e "  ${YELLOW}${BOLD}${ICON_FAIL}  No packages found in ${NC}$DOTFILES_DIR"
    exit 1
fi

# 4. Stow each package with formatted output
for package in $PACKAGES; do
    printf "  ${CYAN}%-32s${NC}" "Stowing $package..."

    # Run stow quietly, capturing both stdout and stderr
    ERROR_MSG=$(stow -R -t "$TARGET_DIR" "$package" 2>&1)

    if [ $? -eq 0 ]; then
        printf " ${GREEN}${BOLD}%s${NC}\n" "${ICON_OK} OK"
    else
        printf " ${RED}${BOLD}%s${NC}\n" "${ICON_FAIL} FAIL"
        echo -e "${RED}${ERROR_MSG}${NC}" | sed 's/^/      /'
    fi
done

echo -e "\n${GREEN}${BOLD}┌─────────────────────────────────────────────────────┐${NC}"
echo -e "${GREEN}${BOLD}│  Deployment complete! ${ICON_OK}                             │${NC}"
echo -e "${GREEN}${BOLD}└─────────────────────────────────────────────────────┘${NC}\n"
