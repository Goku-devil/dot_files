#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

# Resolve the directory of the master_install script dynamically
# This ensures it works no matter where you call it from
BASE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPTS_DIR="$BASE_DIR/install_scripts"

# Define color codes for better terminal readability
GREEN='\033[0;32m'
BLUE='\033[0;34m'
RED='\033[0;31m'
NC='\033[0m' # No Color

echo -e "${BLUE}=======================================${NC}"
echo -e "${BLUE}   Starting Arch Master Installation   ${NC}"
echo -e "${BLUE}=======================================${NC}\n"

# Check if the scripts directory exists
if [ ! -d "$SCRIPTS_DIR" ]; then
    echo -e "${RED}Error: Directory $SCRIPTS_DIR does not exist.${NC}"
    exit 1
fi

# Step 1: System Update & Utilities
echo -e "${GREEN}[1/3] Preparing System (arch_util)...${NC}"
if [ -f "$SCRIPTS_DIR/arch_util" ]; then
    # Note: If 'arch_util' is meant to be a library of functions rather than 
    # a standalone executable, change the line below to: source "$SCRIPTS_DIR/arch_util"
    bash "$SCRIPTS_DIR/arch_util"
else
    echo -e "${RED}Error: arch_util script not found.${NC}"
    exit 1
fi

# Step 2: Install Essential Packages
echo -e "\n${GREEN}[2/3] Installing Essential Packages (waybar, wlogout, etc.)...${NC}"
if [ -f "$SCRIPTS_DIR/install" ]; then
    bash "$SCRIPTS_DIR/install"
else
    echo -e "${RED}Error: install script not found.${NC}"
    exit 1
fi

# Step 3: Install Dotfiles
echo -e "\n${GREEN}[3/3] Setting up Dotfiles...${NC}"
if [ -f "$SCRIPTS_DIR/install_dotfiles" ]; then
    bash "$SCRIPTS_DIR/install_dotfiles"
else
    echo -e "${RED}Error: install_dotfiles script not found.${NC}"
    exit 1
fi

echo -e "\n${BLUE}=======================================${NC}"
echo -e "${GREEN}   Installation Completed Successfully!${NC}"
echo -e "${BLUE}=======================================${NC}"
